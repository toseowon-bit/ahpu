{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DemoBucketSetup",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketWebsite",
        "s3:GetBucketWebsite",
        "s3:PutBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls"
      ],
      "Resource": "arn:aws:s3:::ahpu-demo-6a0deb"
    },
    {
      "Sid": "DemoObjectsUpload",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::ahpu-demo-6a0deb/*"
    }
  ]
}
