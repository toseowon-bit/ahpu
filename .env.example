PORT=3000
HOST=127.0.0.1
DATA_PROVIDER=demo
# 검증 도구 전용. 웹 앱 live 모드는 아직 제공하지 않습니다.
MFDS_API_KEY=
# 쿠팡 파트너스 Open API (없으면 '실제 쿠팡 검색'이 모의 데이터로 동작)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 선택: 파트너스 채널 구분용
COUPANG_SUB_ID=
# Supabase 적재(scripts/sync-mfds.js). 승인되지 않은 경우 비워 두세요.
# service_role 키는 RLS를 우회하므로 서버·스크립트에서만 쓰고 브라우저에 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 앱에서 직접 읽을 때만 사용(현재 앱은 Supabase를 호출하지 않음)
SUPABASE_ANON_KEY=
